# Backend environment variables
# Copy to .env and fill in real values. NEVER commit .env itself.

# Groq
GROQ_API_KEY=gsk_your_key_here

# Model IDs (change if Groq rotates models)
LLM_MODEL_MAIN=openai/gpt-oss-120b
LLM_MODEL_UTILITY=openai/gpt-oss-20b

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (Phase 9+)
# DATABASE_URL=postgresql://app:password@host:5432/dbname?sslmode=verify-full
# Set MIGRATION_DATABASE_URL in the shell only when running Alembic.
# Set ANALYTICS_IP_HASH_KEY using secrets.token_urlsafe(32) to opt in to analytics.

# Rate limits
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
# DAILY_TOKEN_BUDGET=140000

# Inference capacity ceilings (do not grant permission to spend provider quota).
# A fresh, boot-bound remaining-capacity allowance is required; default is resting.
# INFERENCE_SHARED_LIMITS={"rpm":24,"tpm":6400,"rpd":800,"tpd":160000}
# INFERENCE_MAX_ACTIVE=2
# INFERENCE_MAX_WAITERS=8

# Trust forwarding headers only after verifying Render's actual proxy chain.
# Leave the list empty until verified; never configure a trust-all CIDR.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=[]
MAX_REQUEST_BYTES=65536
RATE_LIMIT_MAX_KEYS=4096

# Operator control (optional, disabled when empty). Use secrets.token_urlsafe(32).
# Authenticates controls only; never grants generation by itself. Keep out of frontend.
OPS_TOKEN=

# Optional external operational monitor. No alerts sent without explicit --send.
# Configure on the monitor host; these do not schedule pings inside the API.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic

# Admin (Phase 9+)
# ADMIN_TOKEN=generate-a-strong-random-string

# Notifications (Phase 9+)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
